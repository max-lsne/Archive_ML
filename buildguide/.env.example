# Required for live plan generation and chat. Without it the app runs in demo mode
# (sample projects only) — or set MOCK_CLAUDE=1 to exercise the full flow with a canned plan.
ANTHROPIC_API_KEY=

# Model used for manual analysis and chat (default: claude-opus-5-5).
# BUILDGUIDE_MODEL=claude-opus-5-5

# Effort level for plan generation: low | medium | high | xhigh | max (default: high).
# BUILDGUIDE_EFFORT=high

# Server port (default 8787).
# PORT=8787

# Where downloaded manuals and generated plans are stored (default ./data).
# BUILDGUIDE_DATA_DIR=./data

# Return a bundled sample plan instead of calling Claude. Useful for UI development.
# MOCK_CLAUDE=1

# Also hand the manual PDF to Claude during chat (cached, so cheap after the first turn). Set 0 to send only the plan.
# BUILDGUIDE_CHAT_MANUAL=1

# Chat effort (default low: chat is latency-sensitive).
# BUILDGUIDE_CHAT_EFFORT=low

# Allow links to localhost / private networks (only for testing against a local web server).
# BUILDGUIDE_ALLOW_PRIVATE_URLS=1

# Running behind a corporate proxy? Set HTTPS_PROXY (and HTTP_PROXY) as usual; the
# fetcher honours them directly.
# HTTPS_PROXY=http://proxy.example:3128
